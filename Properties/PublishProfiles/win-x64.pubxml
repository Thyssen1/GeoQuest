<?xml version="1.0" encoding="utf-8"?>
<!--
  Standalone Windows build: one .exe with the .NET runtime, Avalonia, Skia and all
  255 flag assets inside it. The target machine needs nothing installed.

  Publish from the CLI with:
      dotnet publish -p:PublishProfile=win-x64
  or from Visual Studio via Build > Publish.

  PublishTrimmed is deliberately off. Trimming cuts the executable roughly in half,
  but the app fails on startup because both System.Text.Json and Avalonia's default
  ViewLocator rely on reflection that the trimmer removes. See the README.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Roughly halves the executable, at the cost of a little startup time. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>

    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <PublishDir>bin\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
