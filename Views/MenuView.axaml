<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GeoQuest.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="720"
             x:Class="GeoQuest.Views.MenuView"
             x:DataType="vm:MenuViewModel">

    <UserControl.Styles>
        <Style Selector="Button.menu">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0,14" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.menu.primary">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0,18" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- Background layer. Deliberately empty: an animated backdrop drops in here
             without disturbing the menu above it. -->
        <Panel Name="BackdropLayer" />

        <Grid RowDefinitions="*,Auto,Auto,*,Auto" Margin="24">

            <!-- Title -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="2">
                <TextBlock Text="GeoQuest"
                           FontSize="64"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="How well do you know the world?"
                           FontSize="16"
                           Opacity="0.55"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Menu -->
            <StackPanel Grid.Row="2"
                        Width="280"
                        HorizontalAlignment="Center"
                        Margin="0,44,0,0"
                        Spacing="12">
                <Button Classes="menu primary"
                        Content="Play"
                        Command="{Binding PlayCommand}"
                        IsDefault="True" />
                <Button Classes="menu"
                        Content="Options"
                        Command="{Binding OptionsCommand}" />
                <Button Classes="menu"
                        Content="Exit"
                        Command="{Binding ExitCommand}" />
            </StackPanel>

            <!-- Best score -->
            <StackPanel Grid.Row="3"
                        IsVisible="{Binding HasBestScore}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="2">
                <TextBlock Text="{Binding BestScoreLabel}"
                           FontSize="12"
                           Opacity="0.5"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding BestScore}"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="#F1C40F"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="4"
                       Text="{Binding VersionText}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,16"
                       FontSize="11"
                       Opacity="0.3" />
        </Grid>
    </Panel>
</UserControl>
