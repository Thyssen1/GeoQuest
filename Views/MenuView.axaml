<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GeoQuest.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="720"
             x:Class="GeoQuest.Views.MenuView"
             x:DataType="vm:MenuViewModel">

    <UserControl.Styles>
        <!-- Avalonia has no text stroke, so the wordmark is one filled copy over eight
             white copies offset around it. Keep the offsets equal or it reads lopsided. -->
        <Style Selector="TextBlock.wordmark">
            <Setter Property="FontSize" Value="76" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.wordmark.outline">
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="30,26">

        <!-- Status rail: what you hold, and what you have earned -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <Border Grid.Column="0" Classes="pill" Padding="12,6,16,6">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Path Data="M8 14.2C8 14.2 1.6 10.3 1.6 6.1A3.5 3.5 0 0 1 8 4.2A3.5 3.5 0 0 1 14.4 6.1C14.4 10.3 8 14.2 8 14.2Z"
                          Fill="#F3564E" Width="20" Height="20" Stretch="Uniform" />
                    <TextBlock Text="{Binding StartingLivesText}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Classes="pill" Padding="12,6,16,6" IsVisible="{Binding HasBestScore}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Path Data="M12 3L14.6 8.6L20.7 9.4L16.2 13.6L17.4 19.6L12 16.6L6.6 19.6L7.8 13.6L3.3 9.4L9.4 8.6Z"
                          Fill="{StaticResource ScoreBrush}" Stroke="{StaticResource ScoreEdgeBrush}" StrokeThickness="1.4"
                          Width="20" Height="20" Stretch="Uniform" />
                    <TextBlock Text="{Binding BestScore}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Classes="label" Text="{Binding BestScoreLabel}" VerticalAlignment="Center" Margin="2,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Title and menu -->
        <!-- A fixed column width: the wordmark is nine stacked copies, and letting the
             stack size itself to them drags the whole menu off centre. -->
        <StackPanel Grid.Row="1" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center">

            <Panel Height="104" Margin="0,0,0,4">
                <TextBlock Classes="wordmark outline" Text="GeoQuest" Margin="-5,-5,0,0" />
                <TextBlock Classes="wordmark outline" Text="GeoQuest" Margin="5,-5,0,0" />
                <TextBlock Classes="wordmark outline" Text="GeoQuest" Margin="-5,5,0,0" />
                <TextBlock Classes="wordmark outline" Text="GeoQuest" Margin="5,5,0,0" />
                <TextBlock Classes="wordmark outline" Text="GeoQuest" Margin="0,-6,0,0" />
                <TextBlock Classes="wordmark outline" Text="GeoQuest" Margin="0,6,0,0" />
                <TextBlock Classes="wordmark outline" Text="GeoQuest" Margin="-6,0,0,0" />
                <TextBlock Classes="wordmark outline" Text="GeoQuest" Margin="6,0,0,0" />
                <TextBlock Classes="wordmark" Text="GeoQuest" Foreground="#20639B" Margin="0,11,0,0" Opacity="0.25" />
                <TextBlock Classes="wordmark" Text="GeoQuest" Foreground="#FFB22C" />
            </Panel>

            <TextBlock Classes="onSky"
                       Text="How well do you know the world?"
                       FontSize="17"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0" />

            <StackPanel Width="320" Spacing="14" Margin="0,40,0,0">
                <Button Classes="raised primary"
                        Content="PLAY"
                        FontSize="28"
                        CornerRadius="20"
                        Padding="0,14,0,16"
                        HorizontalAlignment="Stretch"
                        Command="{Binding PlayCommand}"
                        IsDefault="True" />

                <Grid ColumnDefinitions="*,14,*">
                    <Button Grid.Column="0" Classes="raised" Content="Options" FontSize="17"
                            HorizontalAlignment="Stretch" Command="{Binding OptionsCommand}" />
                    <Button Grid.Column="2" Classes="raised" Content="Exit" FontSize="17"
                            HorizontalAlignment="Stretch" Command="{Binding ExitCommand}" />
                </Grid>
            </StackPanel>

            <!-- Progress has a home on the menu now: the long game, not just the last run -->
            <Border Classes="card" Width="320" Padding="18,16" Margin="0,36,0,0" Background="#D9FFFFFF">
                <Grid ColumnDefinitions="Auto,16,*">
                    <Panel Grid.Column="0" Width="40" Height="40">
                        <Ellipse Fill="#8FD86B" Stroke="White" StrokeThickness="3" />
                        <Ellipse Stroke="White" StrokeThickness="2.2" Width="16" Height="34" />
                        <Rectangle Fill="White" Height="2.2" Width="34" VerticalAlignment="Center" />
                    </Panel>

                    <StackPanel Grid.Column="2" Spacing="7">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Flags mastered" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding MasteryDetail}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource CorrectEdgeBrush}" />
                        </Grid>
                        <ProgressBar Classes="meter" Minimum="0" Maximum="100" Value="{Binding MasteryPercent}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="{Binding VersionText}"
                   HorizontalAlignment="Right"
                   FontSize="12"
                   Foreground="#8014415E" />
    </Grid>
</UserControl>
