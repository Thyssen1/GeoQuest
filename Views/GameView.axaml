<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GeoQuest.ViewModels"
             xmlns:views="using:GeoQuest.Views"
             xmlns:media="using:Avalonia.Media"
             xmlns:imaging="using:Avalonia.Media.Imaging"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="720"
             x:Class="GeoQuest.Views.GameView"
             x:DataType="vm:GameViewModel">

    <!-- A round draws either a flag or a country outline, and neither the game nor the
         tile needs to know which: the artwork arrives as content and finds its template. -->
    <UserControl.DataTemplates>
        <DataTemplate DataType="imaging:Bitmap">
            <Image Source="{Binding}" Stretch="Fill" />
        </DataTemplate>
        <DataTemplate DataType="media:Geometry">
            <Path Data="{Binding}"
                  Fill="{StaticResource InkBrush}"
                  Stretch="Uniform"
                  Margin="16" />
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles>
        <!-- A tile is a white card holding a flag. The flag PNGs are already rendered on
             a shared 3:2 canvas, so Fill is correct here and letterboxes nothing. -->
        <!-- The edge is a bottom border, so it follows the corner radius instead of
             hanging off it the way an offset shadow does. A resolved state swaps that
             edge for a full ring in its own colour. -->
        <Style Selector="Border.tile">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,6" />
        </Style>

        <Style Selector="Border.tile.correct">
            <Setter Property="BorderThickness" Value="5,5,5,8" />
            <Setter Property="BorderBrush" Value="{StaticResource CorrectBrush}" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style Selector="Border.tile.wrong">
            <Setter Property="BorderThickness" Value="5,5,5,8" />
            <Setter Property="BorderBrush" Value="{StaticResource PlayBrush}" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style Selector="Border.tile.revealed">
            <Setter Property="BorderThickness" Value="5" />
            <Setter Property="BorderBrush" Value="{StaticResource CorrectBrush}" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style Selector="Button.tile">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="10" />

            <!-- Fill the cell: left to size itself to the tile, the button hugs the left
                 edge and the whole grid drifts off centre. -->
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.tile /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.tile:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.tile:pointerover Border.tile">
            <Setter Property="BorderBrush" Value="{StaticResource FocusBrush}" />
        </Style>

        <!-- Everything but the answer steps back once the round resolves. -->
        <Style Selector="Border.tile.dimmed">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <Style Selector="Border.keyBadge">
            <Setter Property="Background" Value="#EBFFFFFF" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="9" />
        </Style>

        <!-- The map gets its own card rather than reusing the flag tile's, because that one
             thickens its border when an answer lands. On a flag that is just a highlight;
             under a map it is a smaller map, so the world would change size every time a
             round ended. Here the chrome is fixed and only its colour resolves. -->
        <Style Selector="Border.mapcard">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="BorderThickness" Value="5,5,5,8" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style Selector="Border.mapcard.correct">
            <Setter Property="BorderBrush" Value="{StaticResource CorrectBrush}" />
        </Style>

        <Style Selector="Border.mapcard.wrong">
            <Setter Property="BorderBrush" Value="{StaticResource PlayBrush}" />
        </Style>

        <Style Selector="Border.banner">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource FocusBrush}" />
            <Setter Property="BorderThickness" Value="4" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="34,7" />
        </Style>

        <Style Selector="Border.banner:not(.shown)">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="Border.banner.correct">
            <Setter Property="BorderBrush" Value="{StaticResource CorrectBrush}" />
        </Style>

        <Style Selector="Border.banner.wrong">
            <Setter Property="BorderBrush" Value="{StaticResource PlayBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="28,24">

        <!-- Status rail -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                <Border Classes="pill" Margin="0,0,10,0" Padding="12,6,16,6" IsVisible="{Binding HasLives}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Data="M8 14.2C8 14.2 1.6 10.3 1.6 6.1A3.5 3.5 0 0 1 8 4.2A3.5 3.5 0 0 1 14.4 6.1C14.4 10.3 8 14.2 8 14.2Z"
                              Fill="#F3564E" Width="20" Height="20" Stretch="Uniform" />
                        <TextBlock Text="{Binding Lives}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Classes="pill" Margin="0,0,10,0" Padding="14,6" IsVisible="{Binding IsBounded}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Classes="label" Text="ROUND" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding RoundText}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Classes="pill" Margin="0,0,10,0" Padding="12,6,16,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Data="M12 3L14.6 8.6L20.7 9.4L16.2 13.6L17.4 19.6L12 16.6L6.6 19.6L7.8 13.6L3.3 9.4L9.4 8.6Z"
                              Fill="{StaticResource ScoreBrush}" Stroke="{StaticResource ScoreEdgeBrush}" StrokeThickness="1.4"
                              Width="20" Height="20" Stretch="Uniform" />
                        <TextBlock Text="{Binding Score}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />

                        <!-- The points just won, popping off the score -->
                        <TextBlock Text="{Binding LastAward, StringFormat='+{0}'}"
                                   IsVisible="{Binding ShowsAward}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource CorrectEdgeBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Classes="pill" Margin="0,0,10,0" Padding="12,6,16,6" Background="#C7FFFFFF">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Data="M13 2L5 14H11L10 22L18 10H12Z"
                              Fill="#FF8A3D" Stroke="#E06A1E" StrokeThickness="1.4"
                              Width="18" Height="18" Stretch="Uniform" />
                        <TextBlock Text="{Binding Streak}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Classes="pill" Padding="12,6,16,6" Background="#C7FFFFFF" IsVisible="{Binding ShowsMastery}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Fill="#8FD86B" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding MasteryText}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Border Grid.Column="1" Classes="pill" Padding="10,5,20,5" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <Panel Width="26" Height="26" VerticalAlignment="Center">
                        <Ellipse Fill="#EAF6FC" Stroke="{StaticResource FocusBrush}" StrokeThickness="2" Margin="0,2,0,0" />
                        <Rectangle Fill="{StaticResource FocusBrush}" Width="12" Height="2.4" RadiusX="1.2" RadiusY="1.2"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" />
                    </Panel>
                    <TextBlock Text="{Binding TimeRemainingText}" FontSize="23" FontWeight="SemiBold"
                               MinWidth="46" TextAlignment="Right" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Leaving mid-run needs somewhere to click, not just a key nobody is told about. -->
            <Button Grid.Column="2" Classes="raised"
                    Width="46" Height="46"
                    CornerRadius="999"
                    Padding="0"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Quit to the menu (Esc)"
                    Command="{Binding ReturnToMenuCommand}">
                <Path Data="M5 5L15 15M15 5L5 15"
                      Stroke="{StaticResource InkMutedBrush}" StrokeThickness="2.6" StrokeLineCap="Round"
                      Width="17" Height="17" Stretch="Uniform" />
            </Button>
        </Grid>

        <ProgressBar Grid.Row="1" Classes="clock" Minimum="0" Maximum="1" Value="{Binding TimeFraction}" Margin="0,12,0,0" />

        <!-- Prompt -->
        <StackPanel Grid.Row="2" Margin="0,18,0,0" IsVisible="{Binding !IsGameOver}" HorizontalAlignment="Center">
            <TextBlock Classes="onSky"
                       Text="{Binding PromptHeading}"
                       FontSize="13"
                       HorizontalAlignment="Center" />

            <!-- In Recall the answer only appears once the round is over, so the banner is
                 faded rather than removed: it keeps its place in the layout whatever size
                 the name inside it turns out to be. Taking it out of the layout instead
                 would push everything below it up, and under a map that means the world
                 changes size as you answer. -->
            <Border Classes="banner"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    MinHeight="56"
                    Classes.shown="{Binding ShowsAnswerName}"
                    Classes.correct="{Binding AnsweredCorrectly}"
                    Classes.wrong="{Binding AnsweredWrongly}">
                <TextBlock Text="{Binding Prompt}"
                           FontSize="34"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <TextBlock Classes="onSky"
                       Text="{Binding AnswerKeysText}"
                       FontSize="12"
                       Opacity="0.85"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0" />
        </StackPanel>

        <!-- Flag grid -->
        <ItemsControl Grid.Row="3"
                      ItemsSource="{Binding Options}"
                      IsVisible="{Binding ShowsGrid}"
                      Margin="0,14,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding $parent[ItemsControl].((vm:GameViewModel)DataContext).GridColumns}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FlagOptionViewModel">
                    <Button Classes="tile"
                            Command="{Binding $parent[ItemsControl].((vm:GameViewModel)DataContext).SelectCommand}"
                            CommandParameter="{Binding}">

                        <!-- Centred in its cell: a capped width left to stretch anchors to the
                             left edge, which drifts the whole grid off centre. -->
                        <Viewbox Stretch="Uniform" MaxWidth="360"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Border Classes="tile"
                                    Width="320" Height="222"
                                    Classes.correct="{Binding IsCorrect}"
                                    Classes.wrong="{Binding IsWrong}"
                                    Classes.revealed="{Binding IsRevealed}"
                                    Classes.dimmed="{Binding IsDimmed}">
                                <Panel>
                                    <Border CornerRadius="11" ClipToBounds="True">
                                        <Panel>
                                            <TextBlock Text="{Binding Code}"
                                                       IsVisible="{Binding !HasArt}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="28"
                                                       Foreground="{StaticResource InkFaintBrush}" />
                                            <ContentControl Content="{Binding Art}"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalContentAlignment="Stretch" />
                                        </Panel>
                                    </Border>

                                    <Border Classes="keyBadge">
                                        <TextBlock Text="{Binding Key}" FontSize="16" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- The moment the round turns on -->
                                    <Panel IsVisible="{Binding IsCorrect}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M18 54L42 78L88 24"
                                              Stroke="White" StrokeThickness="22"
                                              StrokeLineCap="Round" StrokeJoin="Round"
                                              Width="104" Height="104" Stretch="Uniform" />
                                        <Path Data="M18 54L42 78L88 24"
                                              Stroke="#3FBF6E" StrokeThickness="13"
                                              StrokeLineCap="Round" StrokeJoin="Round"
                                              Width="104" Height="104" Stretch="Uniform" />
                                    </Panel>
                                </Panel>
                            </Border>
                        </Viewbox>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Find the City: the world, and wherever on it the player clicks -->
        <Grid Grid.Row="3"
              IsVisible="{Binding ShowsMap}"
              RowDefinitions="*,Auto"
              Margin="0,14,0,0">

            <!-- Centred rather than stretched so the tile hugs the map's 2:1 shape
                 instead of framing it with a band of empty card. -->
            <Border Grid.Row="0"
                    Classes="mapcard"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Classes.correct="{Binding AnsweredCorrectly}"
                    Classes.wrong="{Binding AnsweredWrongly}">
                <views:WorldMapControl Map="{Binding WorldGeometry}"
                                       Pin="{Binding DroppedPin}"
                                       Answer="{Binding AnswerPlace}"
                                       IsDroppable="{Binding IsMapLive}"
                                       DropCommand="{Binding DropPinCommand}"
                                       Cursor="Cross" />
            </Border>

            <!-- Height reserved whether or not anything is in it. The distance only appears
                 on the reveal, and a row that grows under the map would shrink the map
                 itself, so it would change size every time a round ended. -->
            <Panel Grid.Row="1" MinHeight="62">
                <Border Classes="pill"
                        IsVisible="{Binding ShowsDistance}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding DistanceText}" FontSize="18" FontWeight="SemiBold" />
                </Border>
            </Panel>
        </Grid>

        <!-- The answer box for every Recall round, whether the question was drawn as a
             picture or marked on the map. It sits in the same place either way, so there
             is one of it rather than one per panel. -->
        <Grid Grid.Row="3"
              ColumnDefinitions="*,12,Auto"
              Width="560"
              IsVisible="{Binding ShowsNameEntry}"
              VerticalAlignment="Bottom">
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource FocusBrush}" BorderThickness="4"
                    CornerRadius="16" Padding="14,4">
                <AutoCompleteBox ItemsSource="{Binding Choices}"
                                 SelectedItem="{Binding SelectedChoice}"
                                 FilterMode="Contains"
                                 MinimumPrefixLength="1"
                                 IsTextCompletionEnabled="False"
                                 PlaceholderText="{Binding AnswerPlaceholder}"
                                 FontSize="19"
                                 BorderThickness="0"
                                 Background="Transparent" />
            </Border>

            <Button Grid.Column="2" Classes="raised confirm" Content="Guess" FontSize="18"
                    Command="{Binding SubmitCommand}" IsDefault="True" />
        </Grid>

        <!-- Recall: the flag is the question and the player names the country -->
        <StackPanel Grid.Row="3"
                    IsVisible="{Binding ShowsRecall}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="20">

            <Border Classes="tile"
                    Padding="11"
                    Width="420" Height="288"
                    Classes.correct="{Binding AnsweredCorrectly}"
                    Classes.wrong="{Binding AnsweredWrongly}">
                <Border CornerRadius="13" ClipToBounds="True">
                    <ContentControl Content="{Binding PromptArt}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />
                </Border>
            </Border>
        </StackPanel>

        <!-- Run over -->
        <StackPanel Grid.Row="3"
                    IsVisible="{Binding IsGameOver}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="4">

            <TextBlock Classes="onSky"
                       Text="{Binding EndTitle}"
                       FontSize="42"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />

            <Border Classes="card" Padding="26,22" Margin="0,16,0,0" MinWidth="420">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Final score" FontSize="15"
                                   Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Bottom" />
                        <TextBlock Grid.Column="1" Text="{Binding Score}" FontSize="44" FontWeight="Bold"
                                   Foreground="{StaticResource ScoreTextBrush}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsNewBest}">
                        <Path Data="M12 3L14.6 8.6L20.7 9.4L16.2 13.6L17.4 19.6L12 16.6L6.6 19.6L7.8 13.6L3.3 9.4L9.4 8.6Z"
                              Fill="{StaticResource ScoreBrush}" Stroke="{StaticResource ScoreEdgeBrush}" StrokeThickness="1.4"
                              Width="18" Height="18" Stretch="Uniform" />
                        <TextBlock Text="New best score!" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource CorrectEdgeBrush}" />
                    </StackPanel>

                    <TextBlock Text="{Binding ResultMessage}" FontSize="14"
                               Foreground="{StaticResource InkMutedBrush}" />

                    <TextBlock Text="{Binding MasteryDetail}"
                               IsVisible="{Binding ShowsMastery}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource CorrectEdgeBrush}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Classes="raised confirm" Content="Play again" FontSize="19"
                        Padding="34,12,34,14" Command="{Binding StartNewGameCommand}" IsDefault="True" />
                <Button Classes="raised" Content="Main menu" FontSize="19"
                        Padding="30,12,30,14" Command="{Binding ReturnToMenuCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- Result. The row keeps its height so the grid above never jumps. -->
        <!-- Reserved tall enough for the message that appears inside it: at 54 the strip
             still grew by a few pixels when a result landed, which is invisible behind a
             flag grid but resizes the world map. -->
        <Panel Grid.Row="4" MinHeight="62" IsVisible="{Binding !IsGameOver}">
        <Border IsVisible="{Binding HasResultMessage}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,14,0,2"
                MinHeight="38"
                CornerRadius="999"
                Padding="26,7"
                BorderBrush="White"
                BorderThickness="3"
                Background="#C7FFFFFF">
            <TextBlock Text="{Binding ResultMessage}"
                       FontSize="17"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </Border>
        </Panel>
    </Grid>
</UserControl>
