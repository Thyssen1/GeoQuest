<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GeoQuest.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="720"
             x:Class="GeoQuest.Views.OptionsView"
             x:DataType="vm:OptionsViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.settingName">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.settingHint">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <Style Selector="RadioButton">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="30,26">

        <TextBlock Grid.Row="0" Classes="onSky" Text="Options" FontSize="38" FontWeight="Bold" Margin="0,0,0,20" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="14" MaxWidth="600" HorizontalAlignment="Left">

                <!-- Starting lives -->
                <Border Classes="card" Padding="20,18">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Classes="settingName" Text="Starting lives" />
                            <TextBlock Classes="settingHint"
                                       Text="How many wrong answers or timeouts a Normal run survives. Applies to your next run — Hard and Recall always give three." />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <RadioButton GroupName="Lives" Content="1" IsChecked="{Binding IsOneLife}" />
                            <RadioButton GroupName="Lives" Content="3" IsChecked="{Binding IsThreeLives}" />
                            <RadioButton GroupName="Lives" Content="5" IsChecked="{Binding IsFiveLives}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Sound -->
                <Border Classes="card" Padding="20,18">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Classes="settingName" Text="Sound" />
                            <TextBlock Classes="settingHint"
                                       Text="A chime on a right answer, a low tone on a wrong one, and a flourish when a round hands you a life back." />
                        </StackPanel>

                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding SoundEnabled}"
                                      OnContent="On"
                                      OffContent="Off"
                                      VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Best scores -->
                <Border Classes="card" Padding="20,18">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Classes="settingName" Text="Best scores" />
                                <TextBlock Classes="settingHint"
                                           Text="Each mode keeps its own best, shown when you pick a mode. Resetting clears them all and cannot be undone." />
                            </StackPanel>

                            <Button Grid.Column="1" Classes="raised" Content="Reset" FontSize="15"
                                    VerticalAlignment="Center"
                                    Command="{Binding BeginResetScoreCommand}"
                                    IsEnabled="{Binding HasBestScore}"
                                    IsVisible="{Binding !IsConfirmingReset}" />
                        </Grid>

                        <!-- Two-step confirmation, since this destroys data. -->
                        <Border IsVisible="{Binding IsConfirmingReset}"
                                Background="#FFECEA"
                                CornerRadius="14"
                                Padding="16,14">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="Erase your best score in every mode permanently?"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,0,12,0" />
                                <Button Grid.Column="1" Classes="raised" Content="Cancel" FontSize="14"
                                        Margin="0,0,10,0" Command="{Binding CancelResetScoreCommand}" />
                                <Button Grid.Column="2" Classes="raised primary" Content="Erase" FontSize="14"
                                        Command="{Binding ConfirmResetScoreCommand}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Save location -->
                <Border Classes="card" Padding="20,18">
                    <StackPanel>
                        <TextBlock Classes="settingName" Text="Saved data" />
                        <TextBlock Classes="settingHint"
                                   Text="Your scores, settings and learning progress are stored here, outside the app, so they survive upgrades." />
                        <SelectableTextBlock Text="{Binding SaveLocation}"
                                             FontFamily="Consolas,Menlo,monospace"
                                             FontSize="12"
                                             Foreground="{StaticResource InkMutedBrush}"
                                             TextWrapping="Wrap"
                                             Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Classes="raised" Content="Back" FontSize="16"
                Margin="0,20,0,0" HorizontalAlignment="Left" Command="{Binding BackCommand}" />
    </Grid>
</UserControl>
