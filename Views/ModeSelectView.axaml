<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GeoQuest.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="720"
             x:Class="GeoQuest.Views.ModeSelectView"
             x:DataType="vm:ModeSelectViewModel">

    <UserControl.Styles>
        <Style Selector="Button.mode">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,13" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.mode /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Button.mode:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.mode:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.mode:pointerover Border.card">
            <Setter Property="BorderBrush" Value="{StaticResource FocusBrush}" />
        </Style>

        <Style Selector="Button.mode:pressed Border.card">
            <Setter Property="Margin" Value="0,3,0,-3" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="30,26">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0">
                <TextBlock Classes="onSky" Text="{Binding Title}" FontSize="38" FontWeight="Bold" />
                <TextBlock Classes="onSky" Text="Choose a mode — press 1–4, or Enter for the one you played last"
                           FontSize="14" Opacity="0.9" Margin="0,4,0,0" />
            </StackPanel>

            <Button Grid.Column="1" Classes="raised" Content="Back" FontSize="15"
                    VerticalAlignment="Bottom" Command="{Binding BackCommand}" />
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,22,0,0">
            <ItemsControl ItemsSource="{Binding Modes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModeCard">
                        <Button Classes="mode"
                                IsDefault="{Binding IsLastPlayed}"
                                Command="{Binding $parent[ItemsControl].((vm:ModeSelectViewModel)DataContext).ChooseCommand}"
                                CommandParameter="{Binding}">

                            <Border Classes="card" Padding="20,15">
                                <Grid ColumnDefinitions="Auto,16,*,16,Auto">

                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="14"
                                            Background="{Binding KeyBackground}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Key}" FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{Binding KeyForeground}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="2" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="9">
                                            <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" />
                                            <Border Background="#FFE9B0" CornerRadius="999" Padding="10,3"
                                                    VerticalAlignment="Center" IsVisible="{Binding IsLastPlayed}">
                                                <TextBlock Text="LAST PLAYED" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#8A5A11" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Classes="body" Text="{Binding Summary}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Terms}" FontSize="12"
                                                   Foreground="{StaticResource InkFaintBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" />

                                        <Grid ColumnDefinitions="*,10,Auto" Margin="0,7,0,0" IsVisible="{Binding ShowsProgress}">
                                            <ProgressBar Grid.Column="0" Classes="meter" Height="9"
                                                         Minimum="0" Maximum="100" Value="{Binding MasteryPercent}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Progress}" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="{StaticResource CorrectEdgeBrush}" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" IsVisible="{Binding HasBestScore}">
                                        <TextBlock Classes="label" Text="BEST" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding BestScore}" FontSize="24" FontWeight="SemiBold"
                                                   Foreground="{StaticResource ScoreTextBrush}"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
