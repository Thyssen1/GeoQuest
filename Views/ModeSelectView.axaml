<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GeoQuest.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="720"
             x:Class="GeoQuest.Views.ModeSelectView"
             x:DataType="vm:ModeSelectViewModel">

    <UserControl.Styles>
        <!-- The card is the button. Chrome is stripped from the Button itself so the
             Border below can carry the whole appearance, as the flag tiles do. -->
        <Style Selector="Button.mode">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.mode /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Button.mode:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="#14808080" />
            <Setter Property="BorderBrush" Value="#20808080" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.mode:pointerover Border.card">
            <Setter Property="BorderBrush" Value="#5B9DFF" />
        </Style>

        <Style Selector="Border.key">
            <Setter Property="Background" Value="#18808080" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,2,16,0" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">

        <StackPanel Grid.Row="0" Margin="0,4,0,20">
            <TextBlock Text="Choose a mode" FontSize="34" FontWeight="Bold" />
            <TextBlock Text="Press 1–3 to pick, or Enter for the one you played last."
                       FontSize="13"
                       Opacity="0.45"
                       Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Modes}"
                          MaxWidth="600"
                          HorizontalAlignment="Left">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModeCard">
                        <Button Classes="mode"
                                Margin="0,0,0,14"
                                IsDefault="{Binding IsLastPlayed}"
                                Command="{Binding $parent[ItemsControl].((vm:ModeSelectViewModel)DataContext).ChooseCommand}"
                                CommandParameter="{Binding}">

                            <Border Classes="card">
                                <Grid ColumnDefinitions="Auto,*,Auto">

                                    <Border Grid.Column="0" Classes="key">
                                        <TextBlock Text="{Binding Key}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.7"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="21"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Summary}"
                                                   FontSize="13"
                                                   Opacity="0.6"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Terms}"
                                                   FontSize="12"
                                                   Opacity="0.4"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,0" />

                                        <TextBlock Text="{Binding Progress}"
                                                   IsVisible="{Binding ShowsProgress}"
                                                   FontSize="12"
                                                   Foreground="#2ECC71"
                                                   Opacity="0.8"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding HasBestScore}">
                                        <TextBlock Text="BEST"
                                                   FontSize="11"
                                                   Opacity="0.5"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding BestScore}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F1C40F"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2"
                Content="Back"
                Command="{Binding BackCommand}"
                Padding="28,10"
                Margin="0,20,0,40"
                HorizontalAlignment="Left" />
    </Grid>
</UserControl>
