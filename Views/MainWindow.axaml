<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GeoQuest.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="720"
        x:Class="GeoQuest.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1150" Height="800"
        MinWidth="560" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SkyBrush}"
        Title="GeoQuest">

    <Design.DataContext>
        <!-- Previewer only; the runtime DataContext is set in App.axaml.cs -->
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <!-- Bound on the Window so answering by keyboard does not depend on focus. The
         shell forwards them to the game only while a run is on screen. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="D1" Command="{Binding SelectByNumberCommand}" CommandParameter="1" />
        <KeyBinding Gesture="D2" Command="{Binding SelectByNumberCommand}" CommandParameter="2" />
        <KeyBinding Gesture="D3" Command="{Binding SelectByNumberCommand}" CommandParameter="3" />
        <KeyBinding Gesture="D4" Command="{Binding SelectByNumberCommand}" CommandParameter="4" />
        <KeyBinding Gesture="D5" Command="{Binding SelectByNumberCommand}" CommandParameter="5" />
        <KeyBinding Gesture="D6" Command="{Binding SelectByNumberCommand}" CommandParameter="6" />
        <KeyBinding Gesture="NumPad1" Command="{Binding SelectByNumberCommand}" CommandParameter="1" />
        <KeyBinding Gesture="NumPad2" Command="{Binding SelectByNumberCommand}" CommandParameter="2" />
        <KeyBinding Gesture="NumPad3" Command="{Binding SelectByNumberCommand}" CommandParameter="3" />
        <KeyBinding Gesture="NumPad4" Command="{Binding SelectByNumberCommand}" CommandParameter="4" />
        <KeyBinding Gesture="NumPad5" Command="{Binding SelectByNumberCommand}" CommandParameter="5" />
        <KeyBinding Gesture="NumPad6" Command="{Binding SelectByNumberCommand}" CommandParameter="6" />
        <KeyBinding Gesture="Escape" Command="{Binding BackCommand}" />
    </Window.KeyBindings>

    <Panel>
        <!-- The sky belongs to the window, so every page shares one continuous
             background and nothing flashes during the page transition. -->
        <Panel ClipToBounds="True">
            <Panel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-50,110,0,0"
                   Width="250" Height="90" Opacity="0.55">
                <Ellipse Fill="White" Width="150" Height="58" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                <Ellipse Fill="White" Width="112" Height="76" HorizontalAlignment="Center" VerticalAlignment="Top" />
                <Ellipse Fill="White" Width="124" Height="54" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            </Panel>

            <Panel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,280,-60,0"
                   Width="220" Height="80" Opacity="0.45">
                <Ellipse Fill="White" Width="132" Height="52" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                <Ellipse Fill="White" Width="100" Height="68" HorizontalAlignment="Center" VerticalAlignment="Top" />
                <Ellipse Fill="White" Width="110" Height="48" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            </Panel>

            <Panel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="150,0,0,-30"
                   Width="280" Height="100" Opacity="0.5">
                <Ellipse Fill="White" Width="168" Height="66" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                <Ellipse Fill="White" Width="126" Height="86" HorizontalAlignment="Center" VerticalAlignment="Top" />
                <Ellipse Fill="White" Width="140" Height="62" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            </Panel>
        </Panel>

        <!-- Each page is resolved to its view by ViewLocator -->
        <TransitioningContentControl Content="{Binding CurrentPage}">
            <TransitioningContentControl.PageTransition>
                <CrossFade Duration="0:0:0.2" />
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>
    </Panel>

</Window>
