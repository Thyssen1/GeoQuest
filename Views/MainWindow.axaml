<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GeoQuest.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
        x:Class="GeoQuest.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="900" Height="680"
        MinWidth="560" MinHeight="480"
        Title="GeoQuest — Guess the Flag">

    <Design.DataContext>
        <!-- Previewer only; the runtime DataContext is set in App.axaml.cs -->
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <!-- Resolved to GameView by ViewLocator -->
    <ContentControl Content="{Binding Game}" />

</Window>
